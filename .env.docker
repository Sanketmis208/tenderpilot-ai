# Used by docker-compose.yml only. Synthetic local credentials — never reuse outside local development.
TP_ENVIRONMENT=development
TP_MODE=demo
TP_BASE_URL=http://localhost:8080
TP_SECRET_KEY=docker-local-dev-secret-change-me-0123456789abcdef
TP_DATABASE_URL=postgresql+psycopg://tenderpilot:tenderpilot@db:5432/tenderpilot
TP_REDIS_URL=redis://redis:6379/0
TP_STORAGE_BACKEND=s3
TP_S3_ENDPOINT_URL=http://minio:9000
TP_S3_BUCKET=tenderpilot-dev
TP_S3_ACCESS_KEY_ID=minioadmin
TP_S3_SECRET_ACCESS_KEY=minioadmin
TP_SMTP_HOST=mailpit
TP_SMTP_PORT=1025
TP_SMTP_STARTTLS=false
TP_CLAMAV_HOST=clamav
TP_CLAMAV_PORT=3310
