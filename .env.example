# ---- TenderPilot AI configuration (all variables are prefixed TP_) ----
TP_ENVIRONMENT=development
# demo: synthetic data + labelled rule-based analysis when no LLM is configured
# integrated: real providers expected; missing providers are surfaced as errors
TP_MODE=demo
TP_BASE_URL=http://localhost:8080
TP_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# TP_ENCRYPTION_KEY=   # optional separate key for integration credentials

TP_DATABASE_URL=postgresql+psycopg://localhost/tenderpilot
TP_REDIS_URL=redis://localhost:6379/5
# Run jobs inline in the web process (no separate worker). Useful for quick local demos/tests.
TP_CELERY_EAGER=false

# Storage: local | s3   (MinIO: TP_STORAGE_BACKEND=s3 + TP_S3_ENDPOINT_URL=http://localhost:9000)
TP_STORAGE_BACKEND=local
TP_LOCAL_STORAGE_PATH=./var/storage
TP_S3_BUCKET=tenderpilot-dev
TP_S3_REGION=ap-south-1
# TP_S3_ENDPOINT_URL=http://localhost:9000
# TP_S3_ACCESS_KEY_ID=minioadmin
# TP_S3_SECRET_ACCESS_KEY=minioadmin
# TP_S3_KMS_KEY_ID=

# OCR for scanned pages (requires AWS credentials with textract:DetectDocumentText)
TP_TEXTRACT_ENABLED=false

# LLM (optional in demo mode). When no key is set, extraction/copilot use deterministic, labelled rule-based logic.
# Provider: anthropic | groq (Groq's OpenAI-compatible API)
TP_LLM_PROVIDER=anthropic
# TP_ANTHROPIC_API_KEY=
# TP_GROQ_API_KEY=
TP_GROQ_MODEL=openai/gpt-oss-120b
TP_GROQ_FAST_MODEL=openai/gpt-oss-20b
TP_LLM_MODEL=claude-opus-5-5
TP_LLM_FAST_MODEL=claude-haiku-5-5

# Embeddings: hashing (offline, lexical) | openai_compatible
TP_EMBEDDING_PROVIDER=hashing
TP_EMBEDDING_DIM=384
# TP_EMBEDDING_API_URL=https://api.example.com/v1
# TP_EMBEDDING_MODEL=
# TP_EMBEDDING_API_KEY=

# Email (optional). Without SMTP, notifications are in-app only and email status is "skipped_no_provider".
# TP_SMTP_HOST=localhost
# TP_SMTP_PORT=1025
# TP_SMTP_STARTTLS=false

TP_COOKIE_SECURE=false
TP_LOG_JSON=false
# Demo seed password for the synthetic users (see README)
TP_DEMO_PASSWORD=Demo@Pass2026
